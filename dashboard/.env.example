# Public: safe to expose in the browser bundle (Vite inlines VITE_* at build time).
# In Supabase: Settings -> API -> Project URL / Publishable key. Read access is scoped by
# the RLS policies in supabase/migrations/20260923020000_add_public_read_policies.sql.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-only: used by api/leaderboard.ts, never reaches the browser. Do NOT prefix with VITE_.
PULSO_API_URL=https://pulso-transmi.72-60-245-2.sslip.io
PULSO_API_KEY=<pega_tu_clave_del_portal_pulso>
